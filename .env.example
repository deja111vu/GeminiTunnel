# ---- Сгенерируйте оба ключа и подставьте сюда (ОБЯЗАТЕЛЬНО) ----
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"  # ACCOUNTS_ENCRYPTION_KEY
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"  # ADMIN_TOKEN
#
# Плейсхолдеры ниже НЕ проходят zod-валидацию (64 hex) — прокси не
# стартует, пока вы не замените их на сгенерированные значения. Это
# защита от deploy с публично-известным ключом AES-256-GCM: одинаковый
# ключ для всех = шифрование эквивалентно открытому тексту.

# 64 hex символа (32 байта). Используется для AES-256-GCM шифрования
# refresh-токенов в SQLite. ПОТЕРЯ = потеря всех аккаунтов.
ACCOUNTS_ENCRYPTION_KEY=<REPLACE: paste 64 hex chars here, e.g. a1b2c3...>

# 64 hex символа. Bearer-токен для доступа к /admin и /admin/api/*.
# Проверяется через crypto.timingSafeEqual.
ADMIN_TOKEN=<REPLACE: paste 64 hex chars here, e.g. d4e5f6...>

# OAuth client для Google Code Assist. Секрет — обязателен; client_id
# по умолчанию совпадает с gemini-cli, менять не нужно.
# Получите свой секрет, если дефолтный перестанет работать: возьмите
# его из публичного gemini-cli или сгенерируйте через gcloud.
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# ---- Опционально (дефолты подойдут большинству) ----

# Порт прокси внутри контейнера (docker-compose пробрасывает 8000:8000).
PORT=8000

# Интерфейс внутри контейнера. 0.0.0.0 — слушать на всех интерфейсах.
HOST=0.0.0.0

# Куда писать SQLite БД. В docker-compose том монтируется сюда.
DATA_DIR=./data

# Google Code Assist endpoint. Менять только для тестов против mock-сервера.
UPSTREAM_BASE_URL=https://cloudcode-pa.googleapis.com

# pino уровень логов: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Как часто (мс) QuotaPoller опрашивает /retrieveUserQuota на каждом
# аккаунте. Минимум 1000 (1 секунда). По умолчанию 5 минут.
QUOTA_POLL_INTERVAL_MS=300000

# Сколько (мс) держать аккаунт на cooldown после 429, прежде чем снова
# пускать в работу. По умолчанию 60 секунд.
COOLDOWN_AFTER_429_MS=60000

# Сколько раз подряд переключать аккаунты при сбое upstream на один
# запрос. 4 — компромисс: даёт шанс восстановиться при временном
# всплеске 429, не делает хвост ответа слишком длинным.
SWITCH_BUDGET=4

# Таймаут одного upstream-запроса (мс). После него stream прерывается,
# аккаунт остаётся в общем пуле (без cooldown), запрос уходит на другой.
REQUEST_TIMEOUT_MS=120000
